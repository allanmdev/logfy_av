    {
      "name": "03 · Chaves de API (administração)",
      "item": [
        {
          "name": "Criar chave de API",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Credencial administrativa do .env."
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/api-keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}",
                "api-keys"
              ]
            },
            "description": "accountId: CUID da conta. name: 2–150 caracteres. scopes: lista não vazia de routing:read e/ou routing:write. expiresAt: opcional, null ou data ISO 8601 futura com fuso. A chave completa só aparece na criação; captura apiKey e apiKeyId.\n\nStatus esperado: 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Roteirização\",\n  \"scopes\": [\n    \"routing:read\",\n    \"routing:write\"\n  ],\n  \"expiresAt\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json().data;",
                  "  pm.collectionVariables.set(\"apiKeyId\", data.id);",
                  "  pm.collectionVariables.set(\"apiKey\", data.key);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Listar chaves da conta",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Credencial administrativa do .env."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/api-keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}",
                "api-keys"
              ]
            },
            "description": "Retorna { data: [...] }; sem paginação e sem revelar a chave completa.\n\nStatus esperado: 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
