    {
      "name": "06 · Entregas",
      "item": [
        {
          "name": "Adicionar entrega ao plano",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text",
                "description": "Chave completa capturada na criação; exige routing:read para GET e routing:write para escrita."
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/route-plans/{{routePlanId}}/deliveries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "route-plans",
                "{{routePlanId}}",
                "deliveries"
              ]
            },
            "description": "routePlanId: CUID do plano. reference: 1–150 caracteres, única no plano. latitude: -90 a 90; longitude: -180 a 180. demand: inteiro positivo até 2147483647, na mesma unidade da capacidade. serviceDurationSeconds: 0–86400, padrão 0. Captura deliveryId; invalida otimização anterior.\n\nStatus esperado: 201.",
