{
  "info": {
    "name": "Logfy API · Todos os endpoints",
    "description": "27 endpoints da aplicação. Importe também o ambiente local, preencha adminKey e execute as pastas em ordem. IDs e apiKey são capturados automaticamente em variáveis da coleção. A pasta de otimização faz chamadas reais ao Google; a pasta de limpeza exclui os dados criados. Base URL inclui /v1. Corpos de roteirização rejeitam campos desconhecidos e não aceitam accountId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/v1",
      "type": "string"
    },
    {
      "key": "adminKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "apiKeyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehicleId",
      "value": "",
      "type": "string"
    },
    {
      "key": "routePlanId",
      "value": "",
      "type": "string"
    },
    {
      "key": "deliveryId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 · Saúde",
      "item": [
        {
          "name": "Verificar saúde da API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Endpoint público. Retorna serviço, status e timestamp.\n\nStatus esperado: 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "02 · Contas (administração)",
      "item": [
        {
          "name": "Criar conta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Credencial administrativa do .env."
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts"
              ]
            },
            "description": "name: 2–150 caracteres; slug: 2–100 caracteres, letras minúsculas, números e hífens. O GUID evita colisões entre execuções. Captura accountId.\n\nStatus esperado: 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Transportadora Teste\",\n  \"slug\": \"transportadora-{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json().data;",
                  "  pm.collectionVariables.set(\"accountId\", data.id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Listar contas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Credencial administrativa do .env."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts?page=1&limit=20&deleted=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Página, inteiro positivo. Padrão: 1."
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Itens por página: 1 a 100. Padrão: 20."
                },
                {
                  "key": "deleted",
                  "value": "false",
                  "description": "false: não excluídas; true: excluídas; all: todas (padrão)."
                }
              ]
            },
            "description": "Retorna { data, total }.\n\nStatus esperado: 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Consultar conta",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Credencial administrativa do .env."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}"
              ]
            },
            "description": "accountId: CUID retornado ao criar a conta.\n\nStatus esperado: 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Atualizar conta completa",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Credencial administrativa do .env."
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}"
              ]
            },
            "description": "Todos os campos são obrigatórios. status: ACTIVE, SUSPENDED ou INACTIVE. Mantenha ACTIVE para testar a roteirização.\n\nStatus esperado: 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Transportadora Atualizada\",\n  \"slug\": \"transportadora-{{$guid}}\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Atualizar conta parcialmente",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminKey}}",
                "type": "text",
                "description": "Credencial administrativa do .env."
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}"
              ]
            },
            "description": "Aceita name, slug e status; pelo menos um campo. status: ACTIVE, SUSPENDED ou INACTIVE.\n\nStatus esperado: 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Transportadora Logfy\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
