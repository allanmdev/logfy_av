generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Account {
  id     String        @id @default(cuid())
  name   String
  slug   String        @unique
  status AccountStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  apikeys    ApiKey[]
  routePlans RoutePlan[]
  vehicles   Vehicle[]

  @@index([status])
  @@map("accounts")
}

model ApiKey {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name String

  prefix  String
  keyHash String @unique

  scopes String[]

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@index([prefix])
  @@index([revokedAt])
  @@map("api_keys")
}

enum RoutePlanStatus {
  DRAFT
  OPTIMIZED
}

model RoutePlan {
  id             String             @id @default(cuid())
  accountId      String
  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String
  depotLatitude  Float
  depotLongitude Float
  status         RoutePlanStatus    @default(DRAFT)
  version        Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deliveries     Delivery[]
  optimization   RouteOptimization?

  @@unique([id, accountId])
  @@index([accountId, createdAt])
  @@map("route_plans")
}

model Delivery {
  id                     String    @id @default(cuid())
  accountId              String
  routePlanId            String
  routePlan              RoutePlan @relation(fields: [routePlanId, accountId], references: [id, accountId], onDelete: Cascade)
  reference              String
  latitude               Float
  longitude              Float
  demand                 Int
  serviceDurationSeconds Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([routePlanId, reference])
  @@index([accountId, routePlanId])
  @@map("deliveries")
}

model Vehicle {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, active])
  @@map("vehicles")
}

model RouteOptimization {
  id          String    @id @default(cuid())
  accountId   String
  routePlanId String    @unique
  routePlan   RoutePlan @relation(fields: [routePlanId, accountId], references: [id, accountId], onDelete: Cascade)
  result      Json
  createdAt   DateTime  @default(now())

  @@unique([routePlanId, accountId])
  @@index([accountId])
  @@map("route_optimizations")
}
